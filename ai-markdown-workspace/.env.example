# AI Markdown Workspace Configuration

# Application
APP_NAME="AI Markdown Workspace"
DEBUG=true
SECRET_KEY="change-me-in-production"

# Database
DATABASE_PATH="data/workspace.db"

# AI Backend (OpenAI-compatible)
# For Ollama: http://localhost:11434/v1
# For OpenAI: https://api.openai.com/v1
# For Xiaomi Mimo Plan: https://api.mimo.ai/v1
AI_API_ENDPOINT="http://localhost:11434/v1"
AI_API_KEY=""
AI_MODEL="mimo-v2.5"
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_THINKING_MODE="off"

# Xiaomi Mimo Plan API (specific support)
XIAOMI_MIMO_API_ENDPOINT="https://api.mimo.ai/v1"
XIAOMI_MIMO_API_KEY=""  # Enter your Xiaomi Mimo Plan API key here
XIAOMI_MIMO_MODEL="mimo-v2.5"

# OpenRouter API Support (https://openrouter.ai/docs)
OPENROUTER_API_ENDPOINT="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""  # Enter your OpenRouter API key here
OPENROUTER_SITE_URL="http://localhost:8000"
OPENROUTER_SITE_NAME="AI Markdown Workspace"
OPENROUTER_MODEL="meta-llama/llama-3-8b-instruct:free"

# Timezone (fixed to WIB)
TIMEZONE="Asia/Jakarta"

# Markdown Extensions
MARKDOWN_EXTENSIONS="extra,codehilite,toc,fenced_code,tables,strike,task_list,nl2br"

# RAG (disabled by default)
RAG_ENABLED=false
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Token Tracking
TOKEN_TRACKING_ENABLED=true

# Tool Call & MCP (OFF by default)
TOOL_CALL_ENABLED=false
MCP_ENABLED=false

# MCP Server Configuration (for all MCP servers)
# Example: npx -y @modelcontextprotocol/server-filesystem /workspace
MCP_SERVER_COMMAND=""
MCP_SERVER_ARGS=""  # JSON array as string, e.g., '[\"/workspace\"]'
MCP_TRANSPORT="stdio"  # stdio or sse
MCP_SSE_ENDPOINT=""

# Export
EXPORT_INCLUDE_TIMESTAMPS=true
EXPORT_FORMAT="markdown"

# File Manager
WORKSPACES_ROOT="workspaces"
MAX_FILE_SIZE_MB=10
