# AI Markdown Workspace Configuration

# Application
APP_NAME="AI Markdown Workspace"
DEBUG=true
SECRET_KEY="change-me-in-production"

# Database
DATABASE_PATH="data/workspace.db"

# AI Backend (OpenAI-compatible)
# For Ollama: http://localhost:11434/v1
# For OpenAI: https://api.openai.com/v1
AI_API_ENDPOINT="http://localhost:11434/v1"
AI_API_KEY=""
AI_MODEL="mimo-v2.5"
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_THINKING_MODE="off"

# Timezone (fixed to WIB)
TIMEZONE="Asia/Jakarta"

# Markdown Extensions
MARKDOWN_EXTENSIONS="extra,codehilite,toc,fenced_code,tables,strike,task_list,nl2br"

# RAG (disabled by default)
RAG_ENABLED=false
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Token Tracking
TOKEN_TRACKING_ENABLED=true

# Tool Call & MCP (OFF by default)
TOOL_CALL_ENABLED=false
MCP_ENABLED=false

# Export
EXPORT_INCLUDE_TIMESTAMPS=true
EXPORT_FORMAT="markdown"

# File Manager
WORKSPACES_ROOT="workspaces"
MAX_FILE_SIZE_MB=10
